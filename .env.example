# Copy to .env.local. Never commit real secrets.
# Every variable the app reads is listed here.

# Canonical origin used for metadata, sitemap, JSON-LD, and robots.
# No production domain is hardcoded. Local default if unset: http://localhost:3000
# Example after you choose a host: https://example.com
SITE_URL=

# Signs the admin session cookie. Required to sign in. Use a long random string.
SESSION_SECRET=

# Server-only admin password. Compared with a SHA-256 timing-safe check.
# Leave empty to keep /admin/login in a "not configured" state.
ADMIN_PASSWORD=

# Allow the admin UI to write content/*.json. Needs a writable disk
# (local `next dev` / `next start`). Serverless read-only hosts cannot persist writes.
# true | false
CONTENT_WRITABLE=false

# Optional. When "file", validated collaboration inquiries are appended to
# data/collaboration-inquiries.json (gitignored). Default is off: no PII is stored.
COLLAB_STORE=

# Resend. All three are required before /collaborate claims an email was sent.
RESEND_API_KEY=
RESEND_FROM=
COLLAB_TO_EMAIL=

# Dispatches signup. Both are required or the form stays disabled.
# Segment id is the Resend segment the contact is added to.
# Optional topic id records an explicit opt-in for that topic.
RESEND_SEGMENT_ID=
RESEND_TOPIC_ID=

# Cloudflare Turnstile. If the secret is set, the server requires a valid token.
# The site key is public and is the only Turnstile value allowed in the client.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Payments. Booking confirmation happens only after a verified webhook.
# Publishable keys are safe to expose. Secrets must stay server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Set to "razorpay" or "stripe" to choose the provider once its secrets exist.
PAYMENT_PROVIDER=

# Mentorship offerings with scheduleStatus "confirmed" are still not bookable
# until a payment provider is fully configured. There is no pay-later confirmation.

# Privacy-conscious analytics. Leave unset to load no analytics script.
# PLAUSIBLE_DOMAIN is the site domain registered at Plausible.
PLAUSIBLE_DOMAIN=
# Optional self-hosted Plausible or proxy origin. Defaults to https://plausible.io
PLAUSIBLE_SRC=
# Umami. Both required together.
UMAMI_SRC=
UMAMI_WEBSITE_ID=

# Optional Cal.com. Documented integration point. Not called unless set.
# When set, /mentorship/book can link out; this app still does not invent slots.
CALCOM_LINK=
